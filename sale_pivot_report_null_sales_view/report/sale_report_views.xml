<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_order_report_all_products" model="ir.actions.act_window">
        <field name="name">Sales Analysis - All products</field>
        <field name="res_model">sale.report.all</field>
        <field name="view_mode">pivot,tree,graph</field>
        <field name="view_id" />
        <field
            name="context"
        >{'search_default_Sales':1, 'group_by':['product_id']}</field>
    </record>

    <menuitem
        action="action_order_report_all_products"
        id="menu_order_report_all"
        parent="sale.menu_sale_report"
        groups="sales_team.group_sale_manager"
        sequence="15"
    />

    <record id="view_order_product_pivot" model="ir.ui.view">
         <field name="name">sale.report.all.pivot</field>
         <field name="model">sale.report.all</field>
         <field name="arch" type="xml">
             <pivot string="Sales Analysis – All products" sample="1">
                 <field name="product_id" type="row" />
                 <field name="has_sales" type="col" />
                 <field name="price_subtotal" type="measure" />
                 <field name="product_uom_qty" type="measure" />
             </pivot>
         </field>
    </record>

    <record id="view_order_product_search" model="ir.ui.view">
        <field name="name">sale.report.all.search</field>
        <field name="model">sale.report.all</field>
        <field name="arch" type="xml">
            <search string="Sales Analysis">
                <field name="product_id" />
                <field name="product_tmpl_id" />
                <group expand="1" string="Group By">
                    <filter
                        string="Product"
                        name="product_tmpl_id"
                        context="{'group_by':'product_tmpl_id'}"
                    />
                    <filter
                        string="Product Variant"
                        name="product_id"
                        context="{'group_by':'product_id'}"
                        groups="product.group_product_variant"
                    />
                    <separator />
                        <filter
                        name="no_sales"
                        string="No Sales"
                        domain="[('no_sales', '=', True)]"
                    />
                        <filter
                        name="has_sales"
                        string="Has Sales"
                        domain="[('has_sales', '=', True)]"
                    />
                    <separator />
                </group>
            </search>
        </field>
    </record>

    <record id="report_all_channels_sales_action" model="ir.actions.act_window">
        <field name="name">Sales Analysis</field>
        <field name="res_model">sale.report.all</field>
        <field name="view_mode">pivot,tree,graph</field>
    </record>
</odoo>
