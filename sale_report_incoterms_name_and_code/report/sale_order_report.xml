<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="report_saleorder_document_inherit_sale_stock"
        inherit_id="sale_stock.report_saleorder_document_inherit_sale_stock"
    >
        <!-- Replace the core incoterm element with a custom one -->
        <xpath expr="//div[@t-if='doc.incoterm']" position="after">
            <div
                class="col-auto col-3 mw-100 mb-2 incoterm-name-and-code"
                t-if="doc.incoterm"
            >
                <strong>Incoterms:</strong>
                <p>
                     <t class="m-0" t-esc="doc.incoterm.name" /> (<t
                        t-esc="doc.incoterm.code"
                    />)
                </p>
            </div>
        </xpath>

        <xpath expr="//div[@t-if='doc.incoterm']" position="attributes">
            <attribute name="t-if">1==0</attribute>
        </xpath>

    </template>

</odoo>
