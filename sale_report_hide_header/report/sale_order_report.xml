<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="external_layout_striped"
        inherit_id="web.external_layout_striped"
    >
        <xpath expr="//h2[@t-out='layout_document_title']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
        <xpath expr="//h2[@t-out='layout_document_title']" position="after">
            <br/>
        </xpath>
    </template>

