<?xml version="1.0" encoding="utf-8" ?>
<odoo>

  <template id="external_layout_striped" inherit_id="web.external_layout_striped">
    <xpath
      expr="//div[@t-attf-class='o_company_#{company.id}_layout header']"
      position="attributes"
    >
      <attribute name="t-if">False</attribute>
    </xpath>
  </template>

  <template id="external_layout_boxed" inherit_id="web.external_layout_boxed">
    <xpath
      expr="//div[@t-attf-class='header o_company_#{company.id}_layout']"
      position="attributes"
    >
      <attribute name="t-if">False</attribute>
    </xpath>
  </template>

  <template id="external_layout_bold" inherit_id="web.external_layout_bold">
    <xpath
      expr="//div[@t-attf-class='header o_company_#{company.id}_layout']"
      position="attributes"
    >
      <attribute name="t-if">False</attribute>
    </xpath>
  </template>

  <template id="external_layout_standard" inherit_id="web.external_layout_standard">
    <xpath
      expr="//div[@t-attf-class='header o_company_#{company.id}_layout']"
      position="attributes"
    >
      <attribute name="t-if">False</attribute>
    </xpath>
  </template>
  <template id="external_layout_folder" inherit_id="web.external_layout_folder">
    <xpath
      expr='//div[@t-attf-class="header o_company_#{company.id}_layout {{report_type != &apos;pdf&apos; and &apos;h-0&apos;}}"]'
      position="attributes"
    >
      <attribute name="t-if">False</attribute>
    </xpath>
  </template>

  <template id="external_layout_wave" inherit_id="web.external_layout_wave">
    <xpath
      expr='//div[@t-attf-class="header o_company_#{company.id}_layout {{report_type != &apos;pdf&apos; and &apos;h-0&apos;}}"]'
      position="attributes"
    >
      <attribute name="t-if">False</attribute>
    </xpath>
  </template>

  <template id="external_layout_bubble" inherit_id="web.external_layout_bubble">
    <xpath
      expr='//div[@t-attf-class="header o_company_#{company.id}_layout {{report_type == &apos;pdf&apos; and &apos;pt-5&apos;}}"]'
      position="attributes"
    >
      <attribute name="t-if">False</attribute>
    </xpath>
  </template>
</odoo>
