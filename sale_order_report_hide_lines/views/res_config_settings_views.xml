<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record
    id="res_config_settings_view_form_inherit_report_line_mode"
    model="ir.ui.view"
  >
    <field name="name">res.config.settings.view.form.inherit.report.line.mode</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="sale.res_config_settings_view_form" />
    <field name="arch" type="xml">
      <xpath
        expr="//block[@name='quotation_order_setting_container']"
        position="inside"
      >
        <setting
          id="sale_report_line_mode_setting"
          string="Sale Report Line Mode"
          help="Choose the default way product lines are displayed on sale order PDF reports."
        >
          <field name="sale_report_line_mode" required="True" />
        </setting>
      </xpath>
    </field>
  </record>
</odoo>
