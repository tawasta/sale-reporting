<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.view.form.report.sale.order.barcodes</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="sale.res_config_settings_view_form" />
    <field name="arch" type="xml">
      <xpath expr="//setting[@id='proforma_configuration']" position="after">
        <setting
          id="sale_order_product_barcodes"
          string="Show Scannable Product Barcodes On Sale Order Print"
          help="If enabled, show product barcodes as barcodes in the sale order print. If not enabled, just the numeric value of the barcode will be shown."
        >
          <field name="sale_order_product_barcodes" />
        </setting>
      </xpath>
    </field>
  </record>
</odoo>
