<odoo>
    <record id="view_res_config_settings_inherit_account_overdue" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account.overdue</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block id="pay_invoice_online_setting_container" position="inside">
                <setting
                    id="invoice_report_show_overdue_interest"
                    help="If selected, displays overdue interest in the sale order report"
                >
                    <field name="show_overdue_interest" />
                </setting>
            </block>

        </field>
    </record>
</odoo>
