<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="report_saleorder_document_commitment_date_custom_heading"
        inherit_id="sale_report_show_commitment_date.report_saleorder_document_commitment_date"
    >

        <xpath expr="//div[@name='commitment-date']/strong" position="attributes">
            <attribute name="t-if">0 == 1</attribute>
        </xpath>

        <xpath expr="//div[@name='commitment-date']/strong" position="after">
            <strong>
                <t
                    t-out="doc.company_id.sale_report_commitment_date_label or 'Promised Date'"
                />:
            </strong>
        </xpath>
    </template>
</odoo>
